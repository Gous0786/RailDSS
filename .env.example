# Copy to .env (git-ignored) and set your own values. Never commit .env.
POSTGRES_PASSWORD=change-me
# Kafka SASL/PLAIN users (docker-compose.yml; spec NFR-SEC-03). Use different values for each.
KAFKA_ADMIN_PASSWORD=change-me-admin
KAFKA_TWIN_PASSWORD=change-me-twin
KAFKA_EVALUATION_PASSWORD=change-me-evaluation
KAFKA_DSS_PASSWORD=change-me-dss
# Python clients (raildss_common.bus.KafkaSettings.from_env): one principal per process.
RAILDSS_KAFKA_BOOTSTRAP=localhost:9092
RAILDSS_KAFKA_USERNAME=admin
RAILDSS_KAFKA_PASSWORD=change-me-admin
